{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "types": ["vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*", "tests/**/*"]
}
